# Dinamo Rent ERP — variables de entorno opcionales
# (el sistema usa data/config.ini por defecto; estas vars SOLO Override config.ini si están set)

# Clave de cifrado PII (AES-256-GCM, base64 de 32 bytes). Generar con:
#   openssl rand -base64 32
DINAMO_DB_ENCRYPTION_KEY=

# Credenciales Firebird (embedded por defecto; usar solo si se migra a server)
DINAMO_FB_USER=sysdba
DINAMO_FB_PASSWORD=
